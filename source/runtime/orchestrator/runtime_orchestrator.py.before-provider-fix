"""
RanZiz AI Runtime Orchestrator
Version 1.3
"""


class RuntimeOrchestrator:

    def __init__(
        self,
        context_pipeline,
        decision_pipeline,
        memory_pipeline,
        capability_pipeline
    ):
        self.context = context_pipeline
        self.decision = decision_pipeline
        self.memory = memory_pipeline
        self.capability = capability_pipeline

    def execute(
        self,
        message,
        request_context,
        plan=None
    ):

        self.context.execute(
            request_context,
            message
        )

        decision_result = self.decision.execute(
            message,
            request_context
        )

        decision = decision_result.get(
            "decision"
        )

        learned = self.memory.execute(
            message,
            decision
        )

        if learned is not None:
            return learned


        if decision is not None:

            if decision.capabilities:

                capability_plan = decision.to_dict()

                capability_plan["message"] = message

                payload = {
                    "message": message,
                    "context": request_context,
                }

                return self.capability.execute(
                    capability_plan,
                    payload
                )


            provider = getattr(
                decision,
                "provider",
                None
            )

            if provider and hasattr(
                self.capability,
                "execute_provider"
            ):
                return self.capability.execute_provider(
                    provider,
                    message
                )


        return decision_result
